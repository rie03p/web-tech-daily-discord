# Discord channel settings -> Integrations -> Webhooks で作成したURL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# https://platform.openai.com/api-keys で作成。未設定なら要約なしで配信します。
OPENAI_API_KEY=
# 軽量な日次要約向け。利用可能な任意のResponses APIモデルに変更できます。
OPENAI_MODEL=gpt-5.6-luna

# false のとき、既送信URLを除外します。true で同一記事も再テストできます。
INCLUDE_PREVIOUSLY_SENT=false
